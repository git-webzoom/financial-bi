# ─────────────────────────────────────────────────────────────────────────────
# Financial BI — modelo de variáveis de ambiente
#
# COMO USAR:
#   1. Copie este arquivo para .env.local  (cp .env.example .env.local)
#   2. Preencha os valores reais (peça ao responsável pelo projeto por um canal
#      seguro — NUNCA por e-mail/chat público nem commitando no Git).
#
# O .env.local está no .gitignore e NUNCA deve ser versionado.
# ─────────────────────────────────────────────────────────────────────────────

# URL do projeto Supabase (pública). Ex.: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima/pública do Supabase (usada no navegador, respeita RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço do Supabase (SECRETA — acesso total, ignora RLS).
# Usada apenas no servidor / scripts. Nunca expor no frontend nem no Git.
SUPABASE_SERVICE_KEY=
